# Youtube2knowledge on one NVIDIA DGX Spark
NEXT_PUBLIC_API_BASE_URL=http://localhost:8020
NEXT_PUBLIC_GITHUB_URL=https://github.com/LuisAlbertoMunozUbando/youtube2knowledge

APP_ENV=production
APP_DATA_DIR=/data
CORS_ORIGINS=http://localhost:3000
API_PORT=8020
MAX_VIDEO_MINUTES=180
MAX_CONCURRENT_JOBS=1

# NVIDIA Speech NIM: Parakeet 1.1B RNNT Multilingual
TRANSCRIPTION_PROVIDER=nvidia_nim
TRANSCRIPTION_API_BASE_URL=http://asr:9000/v1
TRANSCRIPTION_API_KEY=
TRANSCRIPTION_MODEL=

# Local vLLM OpenAI-compatible endpoint
LLM_API_BASE_URL=http://llm:8000/v1
LLM_API_KEY=
LLM_MODEL=Qwen/Qwen2.5-7B-Instruct
LLM_TIMEOUT_SECONDS=600
LLM_MAX_TOKENS=4096

# Required by NVIDIA Speech NIM. Never commit the populated .env file.
NGC_API_KEY=

# Optional for gated Hugging Face models. The default model is public.
HF_TOKEN=
