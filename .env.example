# Web
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# API
APP_ENV=development
APP_DATA_DIR=./data
CORS_ORIGINS=http://localhost:3000
API_PORT=8020
MAX_VIDEO_MINUTES=180
MAX_CONCURRENT_JOBS=1

# Audio transcription: local_whisper | openai
TRANSCRIPTION_PROVIDER=openai
WHISPER_MODEL=small
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=int8
TRANSCRIPTION_API_BASE_URL=https://api.openai.com/v1
TRANSCRIPTION_API_KEY=
TRANSCRIPTION_MODEL=whisper-1

# Question generation: any OpenAI-compatible chat endpoint
LLM_API_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4.1-mini
LLM_TIMEOUT_SECONDS=180
NEXT_PUBLIC_GITHUB_URL=https://github.com/LuisAlbertoMunozUbando/youtube2knowledge
